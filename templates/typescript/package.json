{
  "name": "{{PROJECT_PACKAGE_NAME}}",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "ticbuild build",
    "watch": "ticbuild watch",
    "run": "ticbuild run",
    "project:update": "ticbuild project update",
    "typecheck": "tsc --noEmit",
