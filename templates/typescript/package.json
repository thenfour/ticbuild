    "check": "ticbuild project check && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "eslint": "{{ESLINT_VERSION}}",
    "ticbuild": "{{TICBUILD_PACKAGE_SPEC}}",
    "typescript": "{{TYPESCRIPT_VERSION}}",
    "typescript-eslint": "{{TYPESCRIPT_ESLINT_VERSION}}"
  }
}
