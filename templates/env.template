# tip: Put machine-specific overrides or secrets in .env.local (which is gitignored)

# Reference environment values in ticbuild substitutions as $(env:NAME).
# NOTE: be careful about putting secrets in environment; you could accidentally
# expose them in code.

# Use an external/stock TIC-80 instead of ticbuild's bundled build.
# 0 = use bundled TIC-80
# 1 = use external TIC-80 (and optional TIC80_LOCATION)
USE_EXTERNAL_TIC80=0
# TIC80_LOCATION=C:\path\to\tic80.exe
