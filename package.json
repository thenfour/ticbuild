{
  "name": "ticbuild",
  "version": "1.0.22",
  "description": "A build & watch system for TIC-80",
  "main": "dist/index.js",
  "bin": {
    "ticbuild": "dist/index.js"
  },
  "scripts": {
    "prepare": "cross-env NODE_ENV=production npm run build",
    "prebuild": "node scripts/gen-build-info.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "build-example-typescript1": "npx tsc && node dist/index.js build examples/typescript1",
    "run-example-typescript1": "npx tsc && node dist/index.js run examples/typescript1",
    "watch-example-typescript1": "npx tsc && node dist/index.js watch examples/typescript1",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "tic80",
    "build",
    "watch",
    "cli"
  ],
  "author": "Carl Corcoran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenfour/ticbuild.git"
  },
  "license": "ISC",
  "files": [
    ".attachments/",
    "dist/",
    "scripts/",
    "templates/",
    "README.md",
    "LICENSE",
    "ticbuild.schema.json"
  ],
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@types/chokidar": "^2.1.7",
    "@types/luaparse": "^0.2.13",
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^11.0.0",
    "dotenv": "^16.0.0",
    "jsonc-parser": "^3.2.0",
    "luaparse": "^0.3.1",
    "typescript": "5.9.3",
    "typescript-to-lua": "1.34.0"
  }
}