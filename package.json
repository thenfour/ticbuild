{
  "name": "ticbuild",
  "version": "1.0.23",
  "description": "A build & watch system for TIC-80",
  "main": "dist/index.js",
  "bin": {
    "ticbuild": "dist/index.js"
  },
  "scripts": {
    "prepare": "cross-env NODE_ENV=production npm run build",
    "prebuild": "node scripts/gen-build-info.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "init-example-typescript1": "npx tsc && node dist/index.js init examples/typescript1 --template typescript --ticbuild-package file:../..",
    "build-example-typescript1": "npx tsc && node dist/index.js build examples/typescript1",
    "run-example-typescript1": "npx tsc && node dist/index.js run examples/typescript1",
    "watch-example-typescript1": "npx tsc && node dist/index.js watch examples/typescript1",
    "prebenchmark:lua-minifiers": "npm run build",
    "benchmark:lua-minifiers": "node scripts/benchmark-lua-minifiers.js",
    "prebenchmark:lz-configs": "npm run build",
    "benchmark:lz-configs": "node scripts/benchmark-lz-configs.js",
    "dev:lua-optimizer": "vite --config devtools/lua-optimizer/vite.config.mts --configLoader runner",
    "build:lua-optimizer": "vite build --config devtools/lua-optimizer/vite.config.mts --configLoader runner",
    "preview:lua-optimizer": "vite preview --config devtools/lua-optimizer/vite.config.mts --configLoader runner",
    "typecheck:lua-optimizer": "tsc --noEmit -p devtools/lua-optimizer/tsconfig.json",
    "dev:lz-compressor": "vite --config devtools/lz-compressor/vite.config.mts --configLoader runner",
    "build:lz-compressor": "vite build --config devtools/lz-compressor/vite.config.mts --configLoader runner",
    "preview:lz-compressor": "vite preview --config devtools/lz-compressor/vite.config.mts --configLoader runner",
    "typecheck:lz-compressor": "tsc --noEmit -p devtools/lz-compressor/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "tic80",
    "build",
    "watch",
    "cli"
  ],
  "author": "Carl Corcoran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenfour/ticbuild.git"
  },
  "license": "ISC",
  "files": [
    ".attachments/",
    "dist/",
    "scripts/",
    "templates/",
    "tic80.d.ts",
    "README.md",
    "LICENSE",
    "ticbuild.schema.json"
  ],
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "eslint": "10.8.1",
    "jest": "^29.0.0",
    "luamin": "^1.0.4",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@types/chokidar": "^2.1.7",
    "@types/luaparse": "^0.2.13",
    "@typescript-to-lua/language-extensions": "1.19.0",
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^11.0.0",
    "dotenv": "^16.0.0",
    "jsonc-parser": "^3.2.0",
    "luaparse": "^0.3.1",
    "source-map": "0.6.1",
    "typescript": "5.9.3",
    "typescript-to-lua": "1.34.0"
  }
}
