{
    "$schema": "./.ticbuild/ticbuild.schema.json",
    "project": {
        "name": "typescript1",
        "importDirs": [
            "assets"
        ],
        "includeDirs": [
            "src"
        ],
        "binDir": "./build/$(buildConfiguration)-bin",
        "objDir": "./build/$(buildConfiguration)-obj",
        "outputCartName": "$(project.name).tic",
    },
    "variables": {
        "gPI": "3.14159"
    },
    "imports": [
        {
            "name": "TypescriptMain",
            "path": "src/tsMain.ts"
        },
        {
            "name": "LuaMain",
            "path": "src/luaMain.lua"
        }
    ],
    "assembly": {
        "lua": {
            "minify": false
        },
        "blocks": [
            {
                "asset": "LuaMain"
            }
        ]
    }
}